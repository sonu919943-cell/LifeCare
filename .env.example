# Database Configuration
DATABASE_URL=postgresql://postgres:password123@localhost:5432/kaamorax
REDIS_URL=redis://localhost:6379

# App Config
NODE_ENV=development
PORT=3000

# Security (Replace these in production)
JWT_SECRET=supersecret123
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# SMS / OTP Provider
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
SMS_PROVIDER_KEY=your_sms_key

# AWS S3 Storage
AWS_REGION=ap-south-1
AWS_S3_BUCKET=kaamorax-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# APIs
GOOGLE_MAPS_API_KEY=
POSTHOG_API_KEY=
SENTRY_DSN=
ENCRYPTION_KEY=supersecretencryptionkey123
