generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum Role {
  WORKER
  EMPLOYER
  ADMIN
  SUPPORT
  OPS
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Platform {
  ANDROID
  IOS
  WEB
}

enum OtpPurpose {
  LOGIN
  REGISTRATION
  RESET
}

enum Availability {
  AVAILABLE
  BUSY
  OFFLINE
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

enum EmployerType {
  INDIVIDUAL
  BUILDER
  CONTRACTOR
  FACTORY
  WAREHOUSE
  HOTEL
  FARMER
  GOVT_CONTRACTOR
  SMB
  ENTERPRISE
}

enum SkillCategory {
  CONSTRUCTION
  DOMESTIC
  DRIVING
  WAREHOUSE
  FACTORY
  AGRICULTURE
  HOSPITALITY
  SECURITY
  EVENT
  HEALTHCARE
  OTHER
}

enum JobStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  FILLED
  COMPLETED
  CANCELLED
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  IMMEDIATE
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  INITIATED
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  CASH
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum NotificationType {
  JOB_MATCH
  JOB_UPDATE
  BOOKING
  PAYMENT
  SYSTEM
  REVIEW
}

enum DocumentType {
  AADHAAR
  PAN
  PHOTO
  GSTIN
  LICENSE
  OTHER
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// --------------------------------------------------------
// USER & AUTHENTICATION
// --------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  phone         String    @unique
  email         String?   @unique
  role          Role      @default(WORKER)
  status        UserStatus @default(ACTIVE)
  isVerified    Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  worker        Worker?
  employer      Employer?
  sessions      Session[]
  notifications Notification[]
  devices       Device[]
  tickets       SupportTicket[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  deviceId     String?
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

model OtpVerification {
  id        String     @id @default(cuid())
  phone     String
  otp       String
  purpose   OtpPurpose @default(LOGIN)
  attempts  Int        @default(0)
  verified  Boolean    @default(false)
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@index([phone, purpose])
}

model Device {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fcmToken  String
  platform  Platform @default(ANDROID)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// --------------------------------------------------------
// WORKER PROFILE
// --------------------------------------------------------

model Worker {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String
  dateOfBirth     DateTime?
  gender          Gender?
  profilePhoto    String?
  aadhaarNumber   String?      @unique
  aadhaarVerified Boolean      @default(false)
  latitude        Float?
  longitude       Float?
  address         String?
  city            String?
  state           String?
  pincode         String?
  bio             String?
  experience      Int?         // years
  dailyRate       Decimal?     @db.Decimal(10, 2)
  availability    Availability @default(AVAILABLE)
  rating          Decimal      @default(0) @db.Decimal(3, 2)
  totalJobs       Int          @default(0)
  totalEarnings   Decimal      @default(0) @db.Decimal(12, 2)
  isOnline        Boolean      @default(false)
  lastSeenAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  skills          WorkerSkill[]
  documents       Document[]
  bookings        Booking[]
  matches         JobMatch[]
  reviews         Review[]      @relation("WorkerReviews")
  attendances     Attendance[]

  @@index([latitude, longitude])
  @@index([city, availability])
}

model WorkerSkill {
  id         String        @id @default(cuid())
  workerId   String
  worker     Worker        @relation(fields: [workerId], references: [id], onDelete: Cascade)
  category   SkillCategory
  skill      String        // e.g. Mason, Painter, Electrician, Helper, Welder
  level      SkillLevel    @default(INTERMEDIATE)

  @@unique([workerId, skill])
  @@index([category])
}

// --------------------------------------------------------
// EMPLOYER PROFILE
// --------------------------------------------------------

model Employer {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            EmployerType @default(INDIVIDUAL)
  fullName        String
  companyName     String?
  gstin           String?
  profilePhoto    String?
  latitude        Float?
  longitude       Float?
  address         String?
  city            String?
  state           String?
  pincode         String?
  rating          Decimal      @default(0) @db.Decimal(3, 2)
  totalHires      Int          @default(0)
  totalSpent      Decimal      @default(0) @db.Decimal(12, 2)
  isVerified      Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  jobs            Job[]
  bookings        Booking[]
  reviews         Review[]     @relation("EmployerReviews")
  documents       Document[]
}

// --------------------------------------------------------
// JOBS & MATCHING
// --------------------------------------------------------

model Job {
  id              String        @id @default(cuid())
  employerId      String
  employer        Employer      @relation(fields: [employerId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  category        SkillCategory
  requiredSkill   String
  skillLevel      SkillLevel?
  workersNeeded   Int           @default(1)
  dailyRate       Decimal       @db.Decimal(10, 2)
  startDate       DateTime
  endDate         DateTime?
  duration        Int?          // days
  latitude        Float
  longitude       Float
  address         String
  city            String
  state           String
  pincode         String
  status          JobStatus     @default(OPEN)
  urgency         Urgency       @default(IMMEDIATE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  bookings        Booking[]
  matches         JobMatch[]

  @@index([category, status, city])
  @@index([latitude, longitude])
  @@index([status, urgency])
}

model JobMatch {
  id          String      @id @default(cuid())
  jobId       String
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId    String
  worker      Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  score       Float       // matching score 0-100
  distance    Float       // km
  status      MatchStatus @default(PENDING)
  notifiedAt  DateTime?
  respondedAt DateTime?
  createdAt   DateTime    @default(now())

  @@unique([jobId, workerId])
  @@index([workerId, status])
}

// --------------------------------------------------------
// BOOKING & PAYMENT
// --------------------------------------------------------

model Booking {
  id                 String        @id @default(cuid())
  jobId              String
  job                Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId           String
  worker             Worker        @relation(fields: [workerId], references: [id], onDelete: Cascade)
  employerId         String
  employer           Employer      @relation(fields: [employerId], references: [id], onDelete: Cascade)
  status             BookingStatus @default(PENDING)
  startDate          DateTime
  endDate            DateTime?
  agreedRate         Decimal       @db.Decimal(10, 2)
  totalAmount        Decimal?      @db.Decimal(12, 2)
  cancellationReason String?
  cancelledBy        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  payments           Payment[]
  attendances        Attendance[]
  reviews            Review[]

  @@index([workerId, status])
  @@index([employerId, status])
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(INITIATED)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  method            PaymentMethod?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([bookingId])
}

// --------------------------------------------------------
// REVIEWS, ATTENDANCE, DOCUMENTS, NOTIFICATIONS
// --------------------------------------------------------

model Review {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reviewerId  String
  workerId    String?
  worker      Worker?  @relation("WorkerReviews", fields: [workerId], references: [id])
  employerId  String?
  employer    Employer? @relation("EmployerReviews", fields: [employerId], references: [id])
  rating      Int      // 1 to 5
  comment     String?
  createdAt   DateTime @default(now())

  @@unique([bookingId, reviewerId])
}

model Attendance {
  id          String           @id @default(cuid())
  bookingId   String
  booking     Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  workerId    String
  worker      Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  checkInAt   DateTime?
  checkOutAt  DateTime?
  checkInLat  Float?
  checkInLng  Float?
  hoursWorked Decimal?         @db.Decimal(4, 2)
  status      AttendanceStatus @default(PRESENT)

  @@unique([bookingId, workerId, date])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  read      Boolean          @default(false)
  sentAt    DateTime         @default(now())

  @@index([userId, read])
}

model Document {
  id              String             @id @default(cuid())
  workerId        String?
  worker          Worker?            @relation(fields: [workerId], references: [id], onDelete: Cascade)
  employerId      String?
  employer        Employer?          @relation(fields: [employerId], references: [id], onDelete: Cascade)
  type            DocumentType       @default(AADHAAR)
  fileUrl         String
  status          VerificationStatus @default(PENDING)
  rejectionReason String?
  verifiedAt      DateTime?
  createdAt       DateTime           @default(now())

  @@index([workerId])
  @@index([employerId])
}

model SupportTicket {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId, status])
}
